# Gemini (Google AI Studio, plano gratuito, sem cartão)
GEMINI_API_KEY=
# Banco: connection string com pooler em modo transação
#   dev  -> Neon (host com -pooler);  prod -> Supabase (pooler, porta 6543)
DATABASE_URL=
# Opcional, só no dev: connection string direta do Neon (sem -pooler),
# usada pela Supabase CLI para aplicar migrações. O app não lê esta variável.
# DATABASE_URL_UNPOOLED=
# Segredo do HMAC do IP no rate limit (gere com: openssl rand -hex 32)
IP_HASH_SECRET=
# Segredo que a Vercel Cron envia em Authorization (gere com: openssl rand -hex 32)
CRON_SECRET=
# Segredo que assina o cookie de sessão do login (gere com: openssl rand -base64 33)
AUTH_SECRET=
# Opcionais: cliente OAuth do Google (passo a passo no DEPLOY.md). Defina as duas ou
# nenhuma. Sem elas, a tela de entrada mostra só "Testar como demo".
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Opcionais: sobrescrevem os modelos definidos em src/config.ts
# CHAT_MODEL=
# FAST_MODEL=
# EMBEDDING_MODEL=
